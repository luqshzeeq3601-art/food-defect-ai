# ========================================
# Food Defect AOI System — Environment
# ========================================

# Server & Runtime
APP_NAME="Food Defect AOI System"
APP_VERSION=0.2.0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8501
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Image Constraints
INPUT_IMAGE_SIZE=640
MAX_IMAGE_SIZE_BYTES=10485760

# Model Paths (relative to project root)
DEFAULT_ONNX_MODEL=models/onnx/best_s.onnx
QUANTIZED_ONNX_MODEL=models/onnx/best_s_int8.onnx
MODEL_WEIGHTS_PATH=models/weights/best_s.pt

# Grading Thresholds
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.45
GRADE_A_THRESHOLD_PERCENT=1.0
GRADE_B_THRESHOLD_PERCENT=5.0
MIN_DEFECT_AREA_PIXELS=50
ENABLE_SPATIAL_INTERSECTION_FILTER=true
